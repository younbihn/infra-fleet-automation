# {{ ansible_managed }}
[Unit]
Description=first-come-api (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
EnvironmentFile=/etc/firstcome-api.env
ExecStart={{ app_dir }}/.venv/bin/uvicorn main:app --host 0.0.0.0 --port {{ app_port }} --workers {{ app_workers }} --proxy-headers --forwarded-allow-ips {{ web_ips | join(',') }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
